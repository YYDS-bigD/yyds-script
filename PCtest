-- YYDS Mouse U
-- U key / U button: free the mouse so you can click menus.
-- U again: restore original shift lock. Also repairs camera if the view went gray.

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local pg = LocalPlayer:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("YYDSMouseU")
if old then
	old:Destroy()
end

local env = getgenv()
env._YYDSMouseUFree = false

local saved = {
	behavior = UIS.MouseBehavior,
	icon = UIS.MouseIconEnabled,
	cameraType = nil,
	cameraSubject = nil,
	cameraOffset = Vector3.zero,
	autoRotate = true,
}

local conn

local function charHum()
	local char = LocalPlayer.Character
	if not char then
		return nil, nil
	end
	return char, char:FindFirstChildOfClass("Humanoid")
end

local function captureState()
	saved.behavior = UIS.MouseBehavior
	saved.icon = UIS.MouseIconEnabled
	local cam = workspace.CurrentCamera
	if cam then
		saved.cameraType = cam.CameraType
		saved.cameraSubject = cam.CameraSubject
	end
	local _, hum = charHum()
	if hum then
		saved.cameraOffset = hum.CameraOffset
		saved.autoRotate = hum.AutoRotate
	end
end

local function repairView()
	local cam = workspace.CurrentCamera
	local char, hum = charHum()
	pcall(function()
		if cam then
			if cam.CameraType == Enum.CameraType.Scriptable then
				cam.CameraType = saved.cameraType or Enum.CameraType.Custom
			end
			if hum and (not cam.CameraSubject or cam.CameraSubject == nil) then
				cam.CameraSubject = hum
			end
		end
		if hum then
			hum.AutoRotate = saved.autoRotate ~= false
		end
		if char then
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("BasePart") then
					d.LocalTransparencyModifier = 0
				end
			end
		end
	end)
end

local function hookMouse()
	if env._YYDSMouseUHooked then
		return
	end
	if not hookmetamethod then
		return
	end
	local wrap = newcclosure or function(f)
		return f
	end
	local ok = pcall(function()
		local oldNew
		oldNew = hookmetamethod(game, "__newindex", wrap(function(self, key, value)
			if env._YYDSMouseUFree and self == UIS and key == "MouseBehavior" then
				if value ~= Enum.MouseBehavior.Default then
					value = Enum.MouseBehavior.Default
				end
			end
			return oldNew(self, key, value)
		end))
	end)
	if ok then
		env._YYDSMouseUHooked = true
	end
end

local function applyFree()
	hookMouse()
	pcall(function()
		UIS.MouseBehavior = Enum.MouseBehavior.Default
	end)
	pcall(function()
		UIS.MouseIconEnabled = true
	end)
	local _, hum = charHum()
	if hum then
		pcall(function()
			hum.CameraOffset = Vector3.zero
			hum.AutoRotate = true
		end)
	end
end

local function applyLock()
	pcall(function()
		UIS.MouseBehavior = saved.behavior or Enum.MouseBehavior.LockCenter
	end)
	pcall(function()
		UIS.MouseIconEnabled = saved.icon
	end)
	local _, hum = charHum()
	if hum then
		pcall(function()
			hum.CameraOffset = saved.cameraOffset or Vector3.zero
			hum.AutoRotate = saved.autoRotate ~= false
		end)
	end
	repairView()
end

local gui = Instance.new("ScreenGui")
gui.Name = "YYDSMouseU"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 9999
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = pg

local btn = Instance.new("TextButton")
btn.Name = "UBtn"
btn.Size = UDim2.new(0, 56, 0, 56)
btn.Position = UDim2.new(0, 16, 0.5, -28)
btn.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
btn.BorderSizePixel = 0
btn.TextColor3 = Color3.fromRGB(240, 240, 240)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 24
btn.Text = "U"
btn.AutoButtonColor = true
btn.Active = true
btn.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = btn

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(80, 80, 88)
stroke.Thickness = 1.5
stroke.Parent = btn

local tip = Instance.new("TextLabel")
tip.Size = UDim2.new(0, 190, 0, 40)
tip.Position = UDim2.new(0, 80, 0.5, -20)
tip.BackgroundTransparency = 1
tip.Font = Enum.Font.Gotham
tip.TextSize = 12
tip.TextColor3 = Color3.fromRGB(210, 210, 210)
tip.TextXAlignment = Enum.TextXAlignment.Left
tip.TextYAlignment = Enum.TextYAlignment.Center
tip.TextWrapped = true
tip.Text = "Shift Lock\nPress U to free mouse"
tip.Parent = gui

local dragging = false
local dragMoved = false
local dragStart
local startPos

btn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragMoved = false
		dragStart = input.Position
		startPos = btn.Position
	end
end)

btn.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if not dragging then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local d = input.Position - dragStart
		if math.abs(d.X) + math.abs(d.Y) > 6 then
			dragMoved = true
		end
		local np = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		btn.Position = np
		tip.Position = UDim2.new(0, np.X.Offset + 64, np.Y.Scale, np.Y.Offset + 8)
	end
end)

local function setFree(on)
	if on then
		captureState()
		env._YYDSMouseUFree = true
		applyFree()
		btn.BackgroundColor3 = Color3.fromRGB(46, 130, 70)
		stroke.Color = Color3.fromRGB(120, 210, 140)
		tip.Text = "Mouse FREE\nPress U to restore lock"
	else
		env._YYDSMouseUFree = false
		applyLock()
		btn.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
		stroke.Color = Color3.fromRGB(80, 80, 88)
		tip.Text = "Shift Lock\nPress U to free mouse"
	end
end

btn.MouseButton1Click:Connect(function()
	if dragMoved then
		return
	end
	setFree(not env._YYDSMouseUFree)
end)

UIS.InputBegan:Connect(function(input, gp)
	if input.KeyCode ~= Enum.KeyCode.U then
		return
	end
	if gp and UIS:GetFocusedTextBox() then
		return
	end
	setFree(not env._YYDSMouseUFree)
end)

if conn then
	conn:Disconnect()
end
conn = RunService.Heartbeat:Connect(function()
	if not gui.Parent then
		conn:Disconnect()
		return
	end
	if env._YYDSMouseUFree then
		if UIS.MouseBehavior ~= Enum.MouseBehavior.Default then
			pcall(function()
				UIS.MouseBehavior = Enum.MouseBehavior.Default
			end)
		end
		if UIS.MouseIconEnabled ~= true then
			pcall(function()
				UIS.MouseIconEnabled = true
			end)
		end
	end
end)

hookMouse()
print("[YYDS] Mouse U ready. Press U to free / restore mouse.")
